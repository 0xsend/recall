{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "recall",
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "toml", "path": "packages/recall/pyproject.toml", "jsonpath": "$.project.version" },
        { "type": "json", "path": ".claude-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": "plugins/recall/.codex-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": ".kimi-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "generic", "path": "scripts/install.sh" }
      ]
    }
  }
}
